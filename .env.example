# Set one key. OPENROUTER_API_KEY, when non-empty, routes every agent LLM
# call through OpenRouter and is used instead of ANTHROPIC_API_KEY.
# The web Admin page (/admin) can save a key in the database. A saved key
# overrides this variable; clear it on that page to fall back to the env var.
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api
AGENCYBILL_DB_PATH=data/agencybill.db
AGENCYBILL_OUTPUT_DIR=output
# Anthropic id, or an OpenRouter slug (anthropic/claude-sonnet-4.6, openai/gpt-4.1).
# Dashed Anthropic ids are mapped to OpenRouter slugs when OPENROUTER_API_KEY is set.
AGENCYBILL_MODEL=claude-sonnet-4-6
AGENCYBILL_MAX_AGENT_TURNS=20
AGENCYBILL_COMMISSION_PCT=0.15

# SendGrid. Email notifications are delivered when both the API key and from
# address are set. Otherwise they are only logged. The Admin page can save
# these and override the environment. Inbound Parse posts to
# /webhooks/sendgrid/inbound. When SENDGRID_INBOUND_TOKEN is set, that URL
# must include ?token= the same value.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=AgencyBill
SENDGRID_INBOUND_DOMAIN=
SENDGRID_INBOUND_TOKEN=

# Web basic auth — set a password before any shared deployment
AGENCYBILL_WEB_USER=agencybill
AGENCYBILL_WEB_PASSWORD=
